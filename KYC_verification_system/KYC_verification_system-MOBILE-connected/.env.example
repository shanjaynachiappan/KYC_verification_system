# Copy this to .env before running `npx expo start`.
#
# IMPORTANT: "localhost" means the phone/emulator itself, not your laptop.
# - Expo web / iOS Simulator: http://localhost:8000 usually works.
# - Physical device via Expo Go / dev build: use your machine's LAN IP,
#   e.g. http://192.168.1.42:8000 (same Wi-Fi network as the backend).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
